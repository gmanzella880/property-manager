# Copy to .env for local development:  cp .env.example .env
# In production these same keys are set as Portainer stack Environment variables.
# .env is gitignored - never commit real values.

# ---- Database ----------------------------------------------------------
# Postgres runs as the "db" service in docker-compose.yml.
# Use a long random value; generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=propertymanager

# Used by the Next.js app and the Prisma CLI. Inside Docker the host is "db".
# For running `npx prisma studio` / `npm run dev` on the host instead, publish
# the db port and swap "db" for "localhost".
DATABASE_URL="postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/propertymanager"
DIRECT_URL="postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/propertymanager"

# ---- Admin auth (Logto) ------------------------------------------------
LOGTO_ENDPOINT=https://your-tenant.logto.app/
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Generate with:  openssl rand -base64 32
LOGTO_COOKIE_SECRET=
# Must match the app's public origin, and be registered as a redirect URI in Logto.
LOGTO_BASE_URL=http://localhost:3000

# ---- App ---------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---- Twilio (optional) -------------------------------------------------
# Leave blank to run without SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Cron (optional) ---------------------------------------------------
# Shared secret required by /api/cron/rent-reminders.
CRON_SECRET=

# ---- Host port (optional) ----------------------------------------------
# Host port mapped to the container's 3000. Change if 3000 is taken.
WEB_PORT=3000
